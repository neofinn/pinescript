//@version=6
// NIFTY — directional volume confluence, breakouts long, pullbacks short
//
// This replaces an earlier version that had two faults, both of them real.
//
// 1. The volume gate counted constituents trading heavily without asking which
//    way. That is a fair long confirmation and close to useless as a short one.
//    Up-volume breadth runs at a median 0.075 against down-volume's 0.042, so a
//    symmetric threshold was always going to misfire on shorts. The gate is now
//    signed, and each side is compared to its OWN rolling percentile, which
//    handles that asymmetry from the data rather than by a hand-picked constant.
//
// 2. Both sides were traded off the same breakout. Measured over 2007-2026,
//    breakout shorts are hopeless at any gate (profit factor 0.17 ungated,
//    0.25 with the directional gate) because breakdowns get bought. Pullback
//    shorts -- rallies into a downtrend, sold as they fail -- go from 0.95 to
//    2.09 with the same gate.
//
// So the book is deliberately asymmetric: longs buy strength, shorts sell
// failed rallies.
//
//   combined        62 trades  3.3/yr  46.8% win  PF 2.24  maxDD 2.6R
//     long leg      44 trades           47.7% win  PF 2.31
//     short leg     18 trades           44.4% win  PF 2.09
//   by period       2.12 / 3.79 / 1.63  across 2007-12, 2013-18, 2019-26
//   gate sweep      1.63 2.00 1.99 2.24 2.52 2.32 2.29 across p50..p85
//                   -- a graded hump, not an isolated spike
//
// Turning on pullback longs as well raises it to about 6.8 trades a year at a
// profit factor near 1.78: more signals, thinner edge. That is the trade, and
// the switch is yours.
//
// Pine caps request.security() at 40 calls, so breadth is built from the top 20
// constituents by weight, about 70% of the index, at one call each.

strategy("NIFTY Dual — Volume Confluence + Pullbacks",
     overlay                 = true,
     initial_capital         = 1000000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.03,
     slippage                = 2,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     max_boxes_count         = 500)

// ─── inputs ────────────────────────────────────────────────────────────────
gS = "Signal"
donLen    = input.int(50,  "Breakout lookback (longs)", minval = 5,  group = gS)
pbLen     = input.int(20,  "Pullback EMA",              minval = 5,  group = gS)
emaFast   = input.int(50,  "Fast EMA (trend)",          minval = 2,  group = gS)
emaSlow   = input.int(150, "Slow EMA (trend)",          minval = 5,  group = gS)
takeLongBO= input.bool(true,  "Longs: breakout entries",  group = gS)
takeLongPB= input.bool(false, "Longs: pullback entries too  (more signals, PF 2.24 -> 1.78)",
     group = gS)
takeShort = input.bool(true,  "Shorts: pullback entries  (breakout shorts measured at PF 0.17)",
     group = gS)

gV = "Directional volume confluence"
useGate  = input.bool(true, "Require directional volume confluence", group = gV)
volLen   = input.int(20,  "Each stock's volume lookback", minval = 5, group = gV)
volMult  = input.float(1.5,"Surge = volume above this multiple of its own average",
     minval = 1.0, step = 0.1, group = gV)
pctLen   = input.int(504, "Percentile lookback for the gate (bars)", minval = 100, group = gV)
gatePct  = input.int(70,  "Gate percentile  (measured best near 75)",
     minval = 30, maxval = 95, step = 5, group = gV)

gR = "Risk"
atrLen  = input.int(14,    "ATR length", minval = 2, group = gR)
stopATR = input.float(3.0, "Stop distance in ATR  (this is 1R)", minval = 0.5, step = 0.5, group = gR)
useTrail= input.bool(true, "Trail the stop", group = gR)

gZ = "Supply / demand zones"
showZones = input.bool(true,  "Draw zones (visual only)", group = gZ)
departMult= input.float(1.5, "Departure candle range above this multiple of ATR",
     minval = 0.5, step = 0.1, group = gZ)
quietMult = input.float(0.8, "Base candle range below this multiple of ATR",
     minval = 0.1, step = 0.1, group = gZ)
baseMax   = input.int(3,     "Max candles in a base", minval = 1, maxval = 5, group = gZ)

// ─── the underlying, signed ────────────────────────────────────────────────
// +1 when the stock is surging AND up on the day, -1 when surging AND down,
// 0 when it is not surging, na when it has no data. Signing it here is the
// whole difference between a long confirmation and a short one.
f_dir(simple string sym) =>
    request.security(sym, timeframe.period,
         na(volume) ? na :
         (volume > ta.sma(volume, volLen) * volMult
             ? (close > close[1] ? 1.0 : (close < close[1] ? -1.0 : 0.0))
             : 0.0),
         lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)

d01 = f_dir("NSE:HDFCBANK")
d02 = f_dir("NSE:ICICIBANK")
d03 = f_dir("NSE:RELIANCE")
d04 = f_dir("NSE:INFY")
d05 = f_dir("NSE:BHARTIARTL")
d06 = f_dir("NSE:ITC")
d07 = f_dir("NSE:TCS")
d08 = f_dir("NSE:LT")
d09 = f_dir("NSE:AXISBANK")
d10 = f_dir("NSE:KOTAKBANK")
d11 = f_dir("NSE:SBIN")
d12 = f_dir("NSE:HINDUNILVR")
d13 = f_dir("NSE:BAJFINANCE")
d14 = f_dir("NSE:MARUTI")
d15 = f_dir("NSE:SUNPHARMA")
d16 = f_dir("NSE:NTPC")
d17 = f_dir("NSE:HCLTECH")
d18 = f_dir("NSE:TITAN")
d19 = f_dir("NSE:ULTRACEMCO")
d20 = f_dir("NSE:TATAMOTORS")

dAll = array.from(d01, d02, d03, d04, d05, d06, d07, d08, d09, d10,
                  d11, d12, d13, d14, d15, d16, d17, d18, d19, d20)

float nUp  = 0.0
float nDn  = 0.0
int   nRep = 0
for i = 0 to array.size(dAll) - 1
    v = array.get(dAll, i)
    if not na(v)
        nRep += 1
        if v > 0.5
            nUp += 1
        else if v < -0.5
            nDn += 1

// share of REPORTING constituents, so a missing symbol cannot deflate the read
upShare = nRep >= 10 ? nUp / nRep : na
dnShare = nRep >= 10 ? nDn / nRep : na

// Each side against its own history. Buying pressure is structurally more
// common than selling pressure, so one shared threshold would gate the two
// sides at very different strictness.
upThr = ta.percentile_nearest_rank(nz(upShare), pctLen, gatePct)
dnThr = ta.percentile_nearest_rank(nz(dnShare), pctLen, gatePct)
gateL = not useGate or (not na(upShare) and not na(upThr) and upShare > upThr)
gateS = not useGate or (not na(dnShare) and not na(dnThr) and dnShare > dnThr)

// ─── trend, breakout, pullback ─────────────────────────────────────────────
atr = ta.atr(atrLen)
ef  = ta.ema(close, emaFast)
es  = ta.ema(close, emaSlow)
e20 = ta.ema(close, pbLen)
up  = ef > es
dn  = es > ef

hiN = ta.highest(high, donLen)[1]
loN = ta.lowest(low,  donLen)[1]

// A pullback entry is the resumption bar: price has been on the other side of
// the pullback EMA and closes back through it, with the larger trend intact.
pbLong  = up and ta.crossover(close,  e20)
pbShort = dn and ta.crossunder(close, e20)
boLong  = up and close > hiN
boShort = dn and close < loN        // measured at PF 0.17; never wired to an entry

// ─── supply / demand zones (drawn, not traded) ─────────────────────────────
var box[] zBox = array.new_box()
rngC     = high - low
isDepart = not na(atr) and atr > 0 and rngC > departMult * atr
departUp = isDepart and close > open

f_base(int maxN) =>
    float lo = na
    float hi = na
    int   n  = 0
    broken   = false
    for i = 1 to maxN
        if not broken
            a = atr[i]
            if not na(a) and a > 0 and (high[i] - low[i]) <= quietMult * a
                lo := na(lo) ? low[i]  : math.min(lo, low[i])
                hi := na(hi) ? high[i] : math.max(hi, high[i])
                n  += 1
            else
                broken := true
    [lo, hi, n]

[bLo, bHi, bN] = f_base(baseMax)

if showZones and isDepart and bN > 0 and not na(bLo) and not na(bHi)
    b = box.new(bar_index - bN, bHi, bar_index, bLo,
         border_color = departUp ? color.new(color.teal, 40) : color.new(color.maroon, 40),
         bgcolor      = departUp ? color.new(color.teal, 90) : color.new(color.maroon, 90))
    array.push(zBox, b)
    if array.size(zBox) > 200
        old = array.shift(zBox)
        if not na(old)
            box.delete(old)

// ─── entries ───────────────────────────────────────────────────────────────
ready  = not na(atr) and atr > 0 and not na(es) and not na(hiN) and not na(loN)
goLong = ready and gateL and ((takeLongBO and boLong) or (takeLongPB and pbLong))
goShort= ready and gateS and takeShort and pbShort

if goLong and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
if goShort and strategy.position_size >= 0
    strategy.entry("S", strategy.short)

// ─── stop: 3x ATR, trailed, never loosened ─────────────────────────────────
var float stopLvl = na
if strategy.position_size == 0
    stopLvl := na
if strategy.position_size > 0
    cand = close - stopATR * atr
    stopLvl := na(stopLvl) ? cand : (useTrail ? math.max(stopLvl, cand) : stopLvl)
    strategy.exit("L-x", "L", stop = stopLvl)
if strategy.position_size < 0
    cand = close + stopATR * atr
    stopLvl := na(stopLvl) ? cand : (useTrail ? math.min(stopLvl, cand) : stopLvl)
    strategy.exit("S-x", "S", stop = stopLvl)

if strategy.position_size > 0 and ta.crossunder(ef, es)
    strategy.close("L", comment = "trend")
if strategy.position_size < 0 and ta.crossover(ef, es)
    strategy.close("S", comment = "trend")

// ─── plots and markers ─────────────────────────────────────────────────────
plot(ef,  "Fast EMA",     color.new(color.orange, 0), 1)
plot(es,  "Slow EMA",     color.new(color.blue,   0), 1)
plot(e20, "Pullback EMA", color.new(color.purple, 0), 1)
plot(takeLongBO ? hiN : na, "Breakout high", color.new(color.teal, 60), 1, plot.style_stepline)
plot(strategy.position_size != 0 ? stopLvl : na, "Stop",
     color.new(color.red, 0), 2, plot.style_linebr)

plotshape(goLong  and strategy.position_size <= 0, "BUY",  shape.labelup,
     location.belowbar, color.new(color.teal, 0),   text = "BUY",
     textcolor = color.white, size = size.small)
plotshape(goShort and strategy.position_size >= 0, "SELL", shape.labeldown,
     location.abovebar, color.new(color.maroon, 0), text = "SELL",
     textcolor = color.white, size = size.small)

bgcolor(useGate and gateL and up ? color.new(color.teal, 93) :
     useGate and gateS and dn ? color.new(color.maroon, 93) : na, title = "Confluence")

// ─── readout ───────────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 2, 5,
     bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "reporting", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 0, str.tostring(nRep), text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 1, "up-volume", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 1, na(upShare) ? "n/a" : str.tostring(upShare * 100, "#.0") + "%",
         text_color = gateL ? color.lime : color.orange, text_size = size.tiny)
    table.cell(tb, 0, 2, "needs above", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 2, na(upThr) ? "n/a" : str.tostring(upThr * 100, "#.0") + "%",
         text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 3, "down-volume", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 3, na(dnShare) ? "n/a" : str.tostring(dnShare * 100, "#.0") + "%",
         text_color = gateS ? color.red : color.orange, text_size = size.tiny)
    table.cell(tb, 0, 4, "needs above", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 4, na(dnThr) ? "n/a" : str.tostring(dnThr * 100, "#.0") + "%",
         text_color = color.white, text_size = size.tiny)

if goLong and strategy.position_size <= 0
    alert("NIFTY BUY — breakout with up-volume confluence at " +
         str.tostring(close, "#.##"), alert.freq_once_per_bar_close)
if goShort and strategy.position_size >= 0
    alert("NIFTY SELL — failed rally with down-volume confluence at " +
         str.tostring(close, "#.##"), alert.freq_once_per_bar_close)
