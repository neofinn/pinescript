//@version=5
// SPX vs DJI: the overlap claim, made checkable on a live chart.
//
// The claim this tests: overlay the S&P 500 and the Dow, and where the two
// lines overlap marks the bottom in the S&P.
//
// Two things this plots, and the comparison between them is the point:
//
//   ratio z   the SPX/DJI ratio's z-score. This is the only scale-free way to
//             express "the two lines crossed" -- an overlay's crossing point
//             depends on the zoom (see SPX_DJI_OVERLAP.md, where changing the
//             visible window retains only 9% of the crossings).
//   SPX z     the S&P's own z-score. No Dow data in it at all.
//
// Measured over 2,731 1-minute, 4,680 5-minute, 5,081 hourly and 5,031 daily
// aligned bars: at z < -2, SPX-alone finds S&P local bottoms more often than
// the ratio does in 8 of 8 configurations, and wins on forward return in 6 of
// 8 -- on the daily, +281 bps against the ratio's +31 bps. Bringing the Dow in
// subtracts information. Watch the two signal rows below fire together, with
// the lower one being the better of the two.
indicator("SPX vs DJI — overlap claim", overlay=false)

symA = input.symbol("SP:SPX",      "Index to find the bottom in", group="Symbols")
symB = input.symbol("DJ:DJI",      "The other index",             group="Symbols")
len  = input.int(60, "Z-score lookback", minval=10, group="Signal")
thr  = input.float(-2.0, "Signal threshold (z below)", step=0.5, group="Signal")

a = request.security(symA, timeframe.period, close)
b = request.security(symB, timeframe.period, close)

z(src) =>
    sd = ta.stdev(src, len)
    sd == 0 ? 0.0 : (src - ta.sma(src, len)) / sd

zRatio = z(b == 0 ? na : a / b)
zSpx   = z(a)

hline(0,   "", color.new(color.gray, 70))
hline(thr, "", color.new(color.gray, 40), hline.style_dashed)

plot(zRatio, "SPX/DJI ratio z", color.new(color.orange, 0), 2)
plot(zSpx,   "SPX alone z",     color.new(color.teal, 0),   2)

sigR = zRatio < thr
sigS = zSpx   < thr
plotshape(sigR, "ratio fires", shape.circle, location.bottom, color.new(color.orange, 20), size=size.tiny)
plotshape(sigS, "SPX fires",   shape.circle, location.bottom, color.new(color.teal, 20),   size=size.tiny, offset=0)

// how often do they disagree? the count is the whole argument
var int both = 0, var int onlyR = 0, var int onlyS = 0
if barstate.isconfirmed and not na(zRatio) and not na(zSpx)
    both  += sigR and sigS ? 1 : 0
    onlyR += sigR and not sigS ? 1 : 0
    onlyS += sigS and not sigR ? 1 : 0

if barstate.islast
    var table t = table.new(position.top_right, 2, 4, border_width=1)
    table.cell(t, 0, 0, "fires",           bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 0, "bars",            bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 0, 1, "both agree",      text_size=size.small)
    table.cell(t, 1, 1, str.tostring(both),  text_size=size.small)
    table.cell(t, 0, 2, "ratio only",      text_color=color.orange, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(onlyR), text_color=color.orange, text_size=size.small)
    table.cell(t, 0, 3, "SPX only",        text_color=color.teal, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(onlyS), text_color=color.teal, text_size=size.small)
