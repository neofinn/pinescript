//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  PPS SUPER HMA   (clip A — @scalping_master_trend)
//
//  Two indicators, read off the clip's own settings dialogs:
//
//    Pivot Point SuperTrend — Pivot Point Period 2, ATR Factor 3, ATR Period 10,
//    "Show Buy/Sell Labels" ticked. These numbers are EXACT, read from the
//    Inputs tab. The Buy and Sell tags on the chart come from here, and "PPS"
//    in the indicator's name is Pivot Point SuperTrend.
//
//    PPS Super HMA — two Hull moving averages (HMA 1 thin, HMA 2 thick) that
//    colour green when rising and red when falling, plus an EWO section. Only
//    the STYLE tab was opened in the clip, so the colours are known and the
//    LENGTHS ARE NOT. They are inputs here, defaulting to a fast/slow pair that
//    matches how the two lines behave on screen.
//
//  What is assumed, because the clip never states it:
//    * the trade is the SuperTrend flip. The HMAs are a filter on it -- that is
//      what a coloured trend line next to a labelled signal is for -- but the
//      clip never says both must agree, so `useHma` turns it off.
//    * no exit is shown other than the opposite label, so that is the default.
//      An ATR stop is available and OFF, since adding one is a different
//      strategy from the one filmed.
//
//  NOT COMPILED. No Pine compiler exists in the environment this was written
//  in. Checked for continuation indentation, local-scope var, plot in blocks
//  and alertcondition in a strategy; never run on a chart.
// ═══════════════════════════════════════════════════════════════════════════

strategy("PPS Super HMA", "PPSHMA", overlay = true, initial_capital = 25000,
 default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
 pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false,
 commission_type = strategy.commission.percent, commission_value = 0.02,
 slippage = 1, max_labels_count = 500, max_lines_count = 500)

G1 = "1 · Pivot Point SuperTrend (exact, from the clip)"
prd    = input.int(2,  "Pivot Point Period", minval = 1, group = G1)
factor = input.float(3.0, "ATR Factor", minval = 0.1, step = 0.1, group = G1)
atrLen = input.int(10, "ATR Period", minval = 1, group = G1)

G2 = "2 · Hull MAs (lengths NOT shown in the clip)"
useHma  = input.bool(true, "Require both HMAs to agree with the signal",
 group = G2, tooltip = "The clip never states this. Off = trade every " +
 "SuperTrend flip, which is the literal reading.")
hma1Len = input.int(21, "HMA 1 length", minval = 2, group = G2)
hma2Len = input.int(55, "HMA 2 length", minval = 2, group = G2)

G3 = "3 · Exit"
exitOpposite = input.bool(true, "Exit on the opposite label", group = G3)
useStop = input.bool(false, "Add an ATR stop (NOT in the clip)", group = G3)
stopAtr = input.float(2.0, "  · x ATR", minval = 0.1, step = 0.1, group = G3)
useTarget = input.bool(false, "Add an R target (NOT in the clip)", group = G3)
rr = input.float(2.0, "  · R multiple", minval = 0.1, step = 0.1, group = G3)

G4 = "4 · Filters"
allowLong  = input.bool(true, "Longs", group = G4)
allowShort = input.bool(true, "Shorts", group = G4)
useSess = input.bool(false, "Restrict to a session", group = G4)
sessSpec = input.session("0930-1600", "Session", group = G4)

// ── Pivot Point SuperTrend ────────────────────────────────────────────────
// The pivot centre is an exponentially-weighted running mean of confirmed
// pivots: each new pivot moves it one third of the way. Pivots arrive `prd`
// bars late and that lag is correct -- a pivot is not knowable before it is
// confirmed, and letting it be known earlier is lookahead.
ph = ta.pivothigh(prd, prd)
pl = ta.pivotlow(prd, prd)

var float centre = na
float lastpp = ph ? ph : pl ? pl : na
if not na(lastpp)
    centre := na(centre) ? lastpp : (centre * 2.0 + lastpp) / 3.0

atr = ta.atr(atrLen)
float up = na(centre) ? na : centre - factor * atr
float dn = na(centre) ? na : centre + factor * atr

var float tUp = na
var float tDn = na
var int trend = 0

if not na(up)
    tUp := close[1] > nz(tUp, up) ? math.max(up, nz(tUp, up)) : up
    tDn := close[1] < nz(tDn, dn) ? math.min(dn, nz(tDn, dn)) : dn
    trend := close > nz(tDn[1], dn) ? 1 : close < nz(tUp[1], up) ? -1 : nz(trend, 1)

trail = trend == 1 ? tUp : tDn
buySig  = trend == 1 and nz(trend[1]) == -1
sellSig = trend == -1 and nz(trend[1]) == 1

// ── Hull moving averages ──────────────────────────────────────────────────
hma(src, len) =>
    ta.wma(2 * ta.wma(src, math.max(1, int(len / 2))) - ta.wma(src, len),
     math.max(1, int(math.round(math.sqrt(len)))))

h1 = hma(close, hma1Len)
h2 = hma(close, hma2Len)
h1Up = h1 > h1[1]
h2Up = h2 > h2[1]

hmaLongOk  = not useHma or (h1Up and h2Up)
hmaShortOk = not useHma or (not h1Up and not h2Up)

inSess = not useSess or not na(time(timeframe.period, sessSpec))

goLong  = buySig  and hmaLongOk  and allowLong  and inSess
goShort = sellSig and hmaShortOk and allowShort and inSess

// ── orders ────────────────────────────────────────────────────────────────
var float stopPx = na
var float targPx = na

if goLong and barstate.isconfirmed
    strategy.entry("L", strategy.long, comment = "PPS buy")
if goShort and barstate.isconfirmed
    strategy.entry("S", strategy.short, comment = "PPS sell")

justL = strategy.position_size > 0 and nz(strategy.position_size[1]) <= 0
justS = strategy.position_size < 0 and nz(strategy.position_size[1]) >= 0

if justL
    e = strategy.position_avg_price
    // clamp below the actual fill: a stop the wrong side of its own entry
    // books an instant loss that reads as the strategy failing
    stopPx := useStop ? math.min(e - atr * stopAtr, e - syminfo.mintick) : na
    targPx := useTarget and useStop ? e + (e - stopPx) * rr : na
if justS
    e = strategy.position_avg_price
    stopPx := useStop ? math.max(e + atr * stopAtr, e + syminfo.mintick) : na
    targPx := useTarget and useStop ? e - (stopPx - e) * rr : na

if strategy.position_size > 0
    if exitOpposite and sellSig and barstate.isconfirmed
        strategy.close("L", comment = "opposite")
    else if useStop and not na(stopPx)
        strategy.exit("Lx", "L", stop = stopPx, limit = targPx)
if strategy.position_size < 0
    if exitOpposite and buySig and barstate.isconfirmed
        strategy.close("S", comment = "opposite")
    else if useStop and not na(stopPx)
        strategy.exit("Sx", "S", stop = stopPx, limit = targPx)

if strategy.position_size == 0
    stopPx := na
    targPx := na

// ── drawing ───────────────────────────────────────────────────────────────
plot(trail, "PPS trail", trend == 1 ? color.new(color.green, 0)
 : color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
plot(h1, "HMA 1", h1Up ? color.new(color.lime, 30) : color.new(color.maroon, 30))
plot(h2, "HMA 2", h2Up ? color.new(color.green, 0) : color.new(color.red, 0),
 linewidth = 3)
plotshape(buySig, "Buy", shape.labelup, location.belowbar,
 color.new(color.green, 0), text = "Buy", textcolor = color.white,
 size = size.tiny)
plotshape(sellSig, "Sell", shape.labeldown, location.abovebar,
 color.new(color.red, 0), text = "Sell", textcolor = color.white,
 size = size.tiny)

var table t = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "PPS", text_size = size.small)
    table.cell(t, 1, 0, str.tostring(prd) + "/" + str.tostring(factor) + "/" +
     str.tostring(atrLen), text_size = size.small)
    table.cell(t, 0, 1, "HMA (assumed)", text_size = size.small)
    table.cell(t, 1, 1, str.tostring(hma1Len) + " / " + str.tostring(hma2Len),
     text_size = size.small, text_color = color.orange)
    table.cell(t, 0, 2, "HMA filter", text_size = size.small)
    table.cell(t, 1, 2, useHma ? "ON" : "off", text_size = size.small)
    table.cell(t, 0, 3, "stop", text_size = size.small)
    table.cell(t, 1, 3, useStop ? str.tostring(stopAtr) + "xATR" : "none",
     text_size = size.small)

if goLong and barstate.isconfirmed
    alert("PPS LONG " + syminfo.ticker, alert.freq_once_per_bar_close)
if goShort and barstate.isconfirmed
    alert("PPS SHORT " + syminfo.ticker, alert.freq_once_per_bar_close)
